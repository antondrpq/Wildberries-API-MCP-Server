# REST API and MCP Streamable HTTP port
PORT=3000

# production | development | test
NODE_ENV=production

# Maximum requests from one IP per minute for the REST API
RATE_LIMIT_MAX=100

# Wildberries seller API token used by MCP tools.
# Keep this secret and do not commit the real value.
WB_API_KEY=

# Optional separate secret protecting the MCP HTTP endpoint.
# If empty, MCP endpoint is accessible without an MCP key.
MCP_API_KEY=

# Timeout for outbound Wildberries API requests, in milliseconds.
WB_REQUEST_TIMEOUT_MS=60000
